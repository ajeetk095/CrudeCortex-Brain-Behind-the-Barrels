# CrudeCortex GWP2 — NO API KEYS ARE REQUIRED. No paid service is used.
# The app runs on the bundled FRED CSV snapshot in data/fred/ and can optionally
# refresh from FRED's public CSV endpoint (no key) or fall back to Yahoo for VIX.
# All variables below are optional; copy to .env or set as Streamlit secrets / env vars.
HTTP_TIMEOUT_S=15
HTTP_RETRIES=3
CACHE_DIR=data/cache
